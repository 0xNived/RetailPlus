# Local PostgreSQL connection. Never commit a real password or production URL.
DATABASE_URL="postgresql://retailplus:change-me@localhost:5432/retailplus?schema=public"
SHADOW_DATABASE_URL="postgresql://retailplus:change-me@localhost:5432/retailplus_shadow?schema=public"

# Used only by `npm run db:seed`. Set a strong value locally when ready.
ADMIN_EMAIL="admin@retailplus.local"
ADMIN_PASSWORD=""
JWT_SECRET="replace-with-a-long-random-value"
FRONTEND_ORIGIN="http://localhost:5173"

# Optional Spark demo: Java 17/21 home; leave empty when java is already on PATH.
SPARK_JAVA_HOME=""
